{
  "name": "hackalem-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "start": "npm run tailwind:build && concurrently -k -n css,react -c magenta,green \"npm:tailwind:watch\" \"react-scripts start\"",
    "tailwind:watch": "tailwindcss -i ./src/styles.css -o ./src/tailwind.css --watch",
    "tailwind:build": "tailwindcss -i ./src/styles.css -o ./src/tailwind.css --minify",
    "build": "npm run tailwind:build && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3"
  }
}
